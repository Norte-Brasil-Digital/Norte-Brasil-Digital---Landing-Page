---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header";
import Produto from "../components/produtos/Produto.astro";

const produtos = [
    {
        id: 1,
        title: "Kitten",
        description: "This is a kitten.",
        image: "https://images.unsplash.com/photo-1559209172-0ff8f6d49ff7?ixlib=rb-1.2.1&ixid=eyJhcHBfaWQiOjEyMDd9&auto=format&fit=crop&w=500&q=80",
    },
    {
        id: 2,
        title: "Mittens",
        description: "This is a mittens.",
        image: "https://images.unsplash.com/photo-1559209172-0ff8f6d49ff7?ixlib=rb-1.2.1&ixid=eyJhcHBfaWQiOjEyMDd9&auto=format&fit=crop&w=500&q=80",
    },
];
---

<Layout title="Norte Brasil Digital">
    <Header client:load />
    <main>
        <h1 class="text-3xl font-bold">Produtos</h1>
        <div>
            {produtos.map((produto) => <Produto />)}
        </div>
    </main>
</Layout>
