---
import "../styles/global.css";
interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const {
  title = "NBD SYS — Gestão inteligente para o varejo | Norte Brasil Digital",
  description = "Organize vendas, estoque e financeiro e acompanhe os resultados com o NBD SYS. Sistema de gestão para o varejo de Parauapebas e região. Solicite uma demonstração.",
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0D2D6E" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="NBD SYS · Norte Brasil Digital" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <title>{title}</title>
    <script
      is:inline
      defer
      src="https://cloud.umami.is/script.js"
      data-website-id="55876612-67da-43fa-8c71-1249ecd14d51"></script>
  </head>
  <body>
    <a href="#conteudo" class="skip-link">Pular para o conteúdo</a>
    <slot />
  </body>
</html>
