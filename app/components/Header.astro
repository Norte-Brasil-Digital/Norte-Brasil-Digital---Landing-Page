---
import Icon from "./Icon.astro";
import { buildWhatsappHref } from "../lib/whatsapp";
---

<header class="site-header">
  <nav class="shell nav" aria-label="Navegação principal">
    <a href="/#inicio" class="wordmark" aria-label="NBD SYS — início">
      <span class="brand-name">NBD<span>SYS</span><i></i></span>
      <span class="brand-tagline">GESTÃO INTELIGENTE</span>
    </a>
    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="main-navigation"
      hidden
    >
      <span>Menu</span><span class="menu-lines" aria-hidden="true"></span>
    </button>
    <div id="main-navigation" class="nav-content">
      <div class="nav-links">
        <a href="/#funcionalidades">Funcionalidades</a>
        <a href="/#sobre">Atendimento</a>
        <a href="/#duvidas">Dúvidas</a>
        <a href="/#contato">Contato</a>
      </div>
      <a
        href={buildWhatsappHref()}
        class="button button-blue"
        target="_blank"
        rel="noopener noreferrer"
        >Solicitar demonstração <Icon name="arrow" size={17} /></a
      >
    </div>
  </nav>
</header>
<script>
  const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const navigation = document.querySelector<HTMLElement>("#main-navigation");
  if (toggle && navigation) {
    toggle.hidden = false;
    navigation.dataset.enhanced = "true";
    const closeMenu = () => {
      toggle.setAttribute("aria-expanded", "false");
      navigation.classList.remove("is-open");
    };
    toggle.addEventListener("click", () => {
      const open = toggle.getAttribute("aria-expanded") !== "true";
      toggle.setAttribute("aria-expanded", String(open));
      navigation.classList.toggle("is-open", open);
    });
    navigation
      .querySelectorAll("a")
      .forEach((link) => link.addEventListener("click", closeMenu));
    document.addEventListener("keydown", (event) => {
      if (
        event.key === "Escape" &&
        toggle.getAttribute("aria-expanded") === "true"
      ) {
        closeMenu();
        toggle.focus();
      }
    });
    document.addEventListener("click", (event) => {
      if (
        event.target instanceof Node &&
        !navigation.contains(event.target) &&
        !toggle.contains(event.target)
      )
        closeMenu();
    });
    window
      .matchMedia("(min-width: 961px)")
      .addEventListener("change", closeMenu);
  }
</script>
<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    background: rgba(255, 255, 255, 0.97);
    border-bottom: 1px solid var(--line);
  }
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    min-height: 92px;
  }
  .wordmark {
    display: flex;
    flex-direction: column;
    line-height: 1;
    flex-shrink: 0;
  }
  .brand-name {
    font-family: "Poppins", sans-serif;
    font-weight: 700;
    font-size: 1.8rem;
    letter-spacing: -0.06em;
    color: var(--blue-dark);
  }
  .brand-name > span {
    font-weight: 500;
    margin-left: 4px;
  }
  .brand-name i {
    display: inline-block;
    background: var(--green);
    width: 7px;
    height: 7px;
    border-radius: 2px;
    margin-left: 5px;
  }
  .brand-tagline {
    margin-top: 7px;
    font-size: 0.53rem;
    letter-spacing: 0.21em;
    font-weight: 600;
    color: var(--muted);
  }
  .nav-content,
  .nav-links {
    display: flex;
    align-items: center;
  }
  .nav-content {
    gap: 34px;
  }
  .nav-links {
    gap: 26px;
    font-size: 0.8rem;
    font-weight: 500;
  }
  .nav-links a {
    padding-block: 12px;
  }
  .nav-links a:hover {
    color: var(--green);
  }
  .nav-content .button {
    font-size: 0.77rem;
    min-height: 44px;
    padding: 12px 16px;
  }
  .menu-toggle {
    display: none;
  }
  @media (max-width: 960px) {
    .nav {
      min-height: 80px;
      flex-wrap: wrap;
      gap: 0;
    }
    .menu-toggle:not([hidden]) {
      display: flex;
      align-items: center;
      gap: 12px;
      border: 1px solid var(--line);
      padding: 10px 12px;
      background: white;
      border-radius: 6px;
      font-size: 0.8rem;
      color: var(--blue-dark);
    }
    .menu-lines {
      width: 18px;
      height: 12px;
      border-block: 2px solid currentColor;
    }
    .nav-content {
      width: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 16px;
      padding: 14px 0 24px;
    }
    .nav-content[data-enhanced="true"] {
      display: none;
    }
    .nav-content.is-open {
      display: flex;
    }
    .nav-links {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }
    .nav-links a {
      border-bottom: 1px solid var(--line);
    }
  }
</style>
