---
import Icon from "./Icon.astro";
const benefits = [
  {
    title: "Menos informações espalhadas.",
    text: "Reúna o que importa na operação para acompanhar as vendas, os produtos e o financeiro com mais organização.",
  },
  {
    title: "Mais clareza para planejar.",
    text: "Use as informações do estoque e do movimento da loja como apoio para definir os próximos passos.",
  },
  {
    title: "Uma visão melhor dos resultados.",
    text: "Acompanhe seu negócio com relatórios que ajudam a entender a operação além da correria do balcão.",
  },
];
---

<section class="benefits section">
  <div class="shell benefits-layout">
    <div class="section-intro">
      <p class="eyebrow">INFORMAÇÃO QUE FAZ DIFERENÇA</p><h2>
        Mais clareza na gestão.<br /><span>Mais foco na sua loja.</span>
      </h2><p>
        Quem empreende no varejo já tem muito para cuidar. A gestão precisa
        ajudar você a entender o negócio e conduzir a rotina.
      </p><a class="text-link" href="#contato"
        >Vamos conversar sobre sua loja <Icon name="arrow" size={18} /></a
      >
    </div>
    <div class="benefit-list">
      {
        benefits.map((benefit, i) => (
          <article>
            <>
              <span class="benefit-number">0{i + 1}</span>
              <div>
                <>
                  <h3>{benefit.title}</h3>
                  <p>{benefit.text}</p>
                </>
              </div>
            </>
          </article>
        ))
      }
    </div>
  </div>
</section>
<style>
  .benefits {
    background: var(--surface);
  }
  .benefits-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 100px;
    align-items: center;
  }
  h2 span {
    color: var(--green);
  }
  .section-intro > p {
    margin-top: 20px;
    color: var(--muted);
    font-size: 0.92rem;
    max-width: 430px;
  }
  .section-intro > .eyebrow {
    color: var(--green);
    margin-top: 0;
    font-size: 0.72rem;
  }
  .text-link {
    margin-top: 28px;
    font-size: 0.8rem;
  }
  .benefit-list article {
    display: flex;
    gap: 20px;
    padding-block: 26px;
    border-bottom: 1px solid #d5dce6;
  }
  .benefit-list article:first-child {
    padding-top: 0;
  }
  .benefit-list article:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }
  .benefit-number {
    color: var(--green);
    font-size: 0.75rem;
    padding-top: 3px;
  }
  .benefit-list h3 {
    font-size: 1.08rem;
  }
  .benefit-list p {
    margin-top: 10px;
    font-size: 0.83rem;
    color: var(--muted);
    line-height: 1.85;
  }
  @media (max-width: 900px) {
    .benefits-layout {
      gap: 44px;
      grid-template-columns: 1fr;
    }
    .section-intro > p {
      max-width: 580px;
    }
  }
</style>
