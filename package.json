{
  "name": "norte-brasil-digital",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "astro build",
    "dev": "astro dev",
    "preview": "astro preview",
    "deploy": "vp run build && wrangler pages deploy ./build/client --project-name norte-brasil-digital",
    "typecheck": "astro check",
    "format:astro": "prettier --plugin prettier-plugin-astro --write \"app/**/*.astro\"",
    "check:astro-format": "prettier --plugin prettier-plugin-astro --check \"app/**/*.astro\"",
    "test:e2e": "playwright test",
    "prepare": "vp config"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "astro": "^7.3.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.3",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "^4.111.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.14.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
